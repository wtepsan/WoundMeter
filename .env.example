# Generate installation secrets on the deployment host with: python3 resources/configure.py
# Never commit real passwords, secrets, encryption keys, or API keys.
POSTGRES_PASSWORD=
SESSION_SECRET=
PATIENT_DATA_KEY=
PATIENT_INDEX_KEY=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_TOTP_SECRET=
ORGANIZATION_NAME=WoundMeter
CLINICAL_TIMEZONE=Asia/Bangkok

# Meta Model API (SAM 3.1, Muse Spark 1.3, Muse Voice Transcribe 1.0)
# Set META_API_KEY to your private key when META_AI_ENABLED=true; local measurement works without it.
META_AI_ENABLED=true
META_API_KEY=

# Demo mode: one-click demo accounts on / and stateless /demo workbench. Never enable with real patient data.
# After changing, rebuild: docker compose up -d --build
WOUNDMETER_DEMO_MODE=true
# Demo mode only: keep /demo photos and results in ./demo-data/images (separate from patient data).
WOUNDMETER_DEMO_KEEP_PHOTOS=true

